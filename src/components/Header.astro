---
import { Image } from 'astro:assets';
import logoImg from '../assets/products/cropped-IMG-20250902-WA0023.jpg';
---
<header class="sticky top-0 z-50 w-full bg-white/90 backdrop-blur-md shadow-[0_2px_20px_rgba(15,23,42,0.08)] border-b border-gray-100 transition-all duration-300">
  <div class="container mx-auto px-4 h-20 flex items-center justify-between">
    <!-- Logo Area -->
    <a href="/" class="flex items-center group">
      <div class="p-1 rounded-lg transition-transform duration-500 group-hover:scale-105">
        <Image 
          src={logoImg} 
          alt="Mitra Technic Logo" 
          width={180} 
          height={72} 
          class="h-10 w-auto object-contain drop-shadow-sm"
        />
      </div>
    </a>
    
    <!-- Mobile Menu Button -->
    <button id="mobile-menu-btn" class="md:hidden relative z-[60] p-2 text-slate-800 hover:text-mitra-blue focus:outline-none transition-colors" aria-label="Toggle Menu">
      <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path id="menu-icon-bars" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" class="transition-all duration-300" />
        <path id="menu-icon-close" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" class="transition-all duration-300 hidden opacity-0" />
      </svg>
    </button>

    <!-- Desktop Navigation Area -->
    <nav class="hidden md:flex gap-8 font-semibold text-slate-700 items-center">
      <a href="/" class="hover:text-mitra-red transition-colors duration-300 relative after:content-[''] after:absolute after:-bottom-1 after:left-0 after:w-0 after:h-0.5 after:bg-mitra-red after:transition-all after:duration-300 hover:after:w-full">Beranda</a>
      
      <div class="relative group">
        <button class="hover:text-mitra-red transition-colors duration-300 flex items-center gap-1 py-8 relative after:content-[''] after:absolute after:bottom-7 after:left-0 after:w-0 after:h-0.5 after:bg-mitra-red after:transition-all after:duration-300 group-hover:after:w-full">
          Produk
          <svg class="w-4 h-4 transition-transform duration-300 group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
        </button>
        <!-- Dropdown Menu -->
        <div class="absolute left-0 top-full mt-0 w-72 bg-white border border-gray-100 rounded-xl shadow-[0_10px_40px_rgba(15,23,42,0.1)] opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300 overflow-hidden transform translate-y-2 group-hover:translate-y-0 before:absolute before:top-0 before:left-0 before:w-full before:h-1 before:bg-gradient-to-r before:from-mitra-blue before:to-mitra-red">
          <ul class="py-3 text-sm text-gray-600">
            <li><a href="/alat-listrik" class="block px-6 py-2.5 hover:bg-slate-50 hover:text-mitra-red hover:pl-8 transition-all duration-300">Alat Listrik</a></li>
            <li><a href="/lampu" class="block px-6 py-2.5 hover:bg-slate-50 hover:text-mitra-red hover:pl-8 transition-all duration-300">Lampu</a></li>
            <li><a href="/kabel" class="block px-6 py-2.5 hover:bg-slate-50 hover:text-mitra-red hover:pl-8 transition-all duration-300">Kabel</a></li>
            <li><a href="/sparepart-mesin" class="block px-6 py-2.5 hover:bg-slate-50 hover:text-mitra-red hover:pl-8 transition-all duration-300">Sparepart Mesin Cuci</a></li>
            <li><a href="/sparepart-kulkas" class="block px-6 py-2.5 hover:bg-slate-50 hover:text-mitra-red hover:pl-8 transition-all duration-300">Sparepart Kulkas</a></li>
            <li><a href="/sparepart-ac" class="block px-6 py-2.5 hover:bg-slate-50 hover:text-mitra-red hover:pl-8 transition-all duration-300">Sparepart AC</a></li>
            <li><a href="/sparepart-rumah-tangga" class="block px-6 py-2.5 hover:bg-slate-50 hover:text-mitra-red hover:pl-8 transition-all duration-300">Sparepart Aplikasi Rumah Tangga</a></li>
            <li><a href="/aksesoris-teknik" class="block px-6 py-2.5 hover:bg-slate-50 hover:text-mitra-red hover:pl-8 transition-all duration-300">Aksesoris Teknik</a></li>
            <li><a href="/aksesoris-audio" class="block px-6 py-2.5 hover:bg-slate-50 hover:text-mitra-red hover:pl-8 transition-all duration-300">Aksesoris Audio</a></li>
          </ul>
        </div>
      </div>
      
      <a href="/tentang-kami" class="hover:text-mitra-red transition-colors duration-300 relative after:content-[''] after:absolute after:-bottom-1 after:left-0 after:w-0 after:h-0.5 after:bg-mitra-red after:transition-all after:duration-300 hover:after:w-full">Tentang Kami</a>
      <a href="/hubungi-kami" class="ml-4 px-6 py-2.5 bg-mitra-blue text-white rounded-full hover:bg-mitra-red hover:shadow-[0_0_20px_rgba(225,29,72,0.4)] transition-all duration-500 hover:-translate-y-1">Hubungi Kami</a>
    </nav>
  </div>

  <!-- Mobile Menu Overlay -->
  <div id="mobile-menu" class="fixed inset-0 bg-white z-[50] md:hidden opacity-0 invisible transition-all duration-300 ease-in-out">
    <div class="flex flex-col h-full pt-24 pb-8 px-6 overflow-y-auto">
      <nav class="flex flex-col gap-6 text-xl font-bold text-slate-800">
        <a href="/" class="mobile-link py-2 border-b border-slate-100 hover:text-mitra-red transition-colors">Beranda</a>
        
        <!-- Mobile Dropdown Group -->
        <div class="py-2 border-b border-slate-100">
          <button id="mobile-produk-btn" class="flex items-center justify-between w-full text-left hover:text-mitra-red transition-colors">
            Produk
            <svg id="mobile-produk-icon" class="w-5 h-5 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
          </button>
          <div id="mobile-produk-menu" class="hidden flex-col gap-4 mt-4 px-4 py-3 bg-slate-50 rounded-xl text-base font-medium text-slate-600">
            <a href="/alat-listrik" class="mobile-link hover:text-mitra-red transition-colors">Alat Listrik</a>
            <a href="/lampu" class="mobile-link hover:text-mitra-red transition-colors">Lampu</a>
            <a href="/kabel" class="mobile-link hover:text-mitra-red transition-colors">Kabel</a>
            <a href="/sparepart-mesin" class="mobile-link hover:text-mitra-red transition-colors">Sparepart Mesin Cuci</a>
            <a href="/sparepart-kulkas" class="mobile-link hover:text-mitra-red transition-colors">Sparepart Kulkas</a>
            <a href="/sparepart-ac" class="mobile-link hover:text-mitra-red transition-colors">Sparepart AC</a>
            <a href="/sparepart-rumah-tangga" class="mobile-link hover:text-mitra-red transition-colors">Sparepart Aplikasi Rumah Tangga</a>
            <a href="/aksesoris-teknik" class="mobile-link hover:text-mitra-red transition-colors">Aksesoris Teknik</a>
            <a href="/aksesoris-audio" class="mobile-link hover:text-mitra-red transition-colors">Aksesoris Audio</a>
          </div>
        </div>

        <a href="/tentang-kami" class="mobile-link py-2 border-b border-slate-100 hover:text-mitra-red transition-colors">Tentang Kami</a>
      </nav>
      
      <div class="mt-auto pt-8">
        <a href="/hubungi-kami" class="mobile-link block w-full text-center py-4 bg-mitra-blue text-white rounded-full hover:bg-mitra-red hover:shadow-[0_0_20px_rgba(225,29,72,0.4)] transition-all duration-300">
          Hubungi Kami
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  // Mobile Menu Logic
  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const iconBars = document.getElementById('menu-icon-bars');
  const iconClose = document.getElementById('menu-icon-close');
  
  const produkBtn = document.getElementById('mobile-produk-btn');
  const produkMenu = document.getElementById('mobile-produk-menu');
  const produkIcon = document.getElementById('mobile-produk-icon');
  
  const mobileLinks = document.querySelectorAll('.mobile-link');
  let isMenuOpen = false;

  function toggleMenu() {
    isMenuOpen = !isMenuOpen;
    if (isMenuOpen) {
      mobileMenu?.classList.remove('opacity-0', 'invisible');
      mobileMenu?.classList.add('opacity-100', 'visible');
      iconBars?.classList.add('hidden', 'opacity-0');
      iconClose?.classList.remove('hidden', 'opacity-0');
      document.body.style.overflow = 'hidden'; // Prevent scrolling
    } else {
      mobileMenu?.classList.remove('opacity-100', 'visible');
      mobileMenu?.classList.add('opacity-0', 'invisible');
      iconBars?.classList.remove('hidden', 'opacity-0');
      iconClose?.classList.add('hidden', 'opacity-0');
      document.body.style.overflow = '';
      
      // Close dropdown if open
      if (produkMenu && !produkMenu.classList.contains('hidden')) {
        produkMenu.classList.add('hidden');
        produkMenu.classList.remove('flex');
        if(produkIcon) produkIcon.style.transform = 'rotate(0deg)';
      }
    }
  }

  menuBtn?.addEventListener('click', toggleMenu);

  produkBtn?.addEventListener('click', () => {
    if (produkMenu?.classList.contains('hidden')) {
      produkMenu.classList.remove('hidden');
      produkMenu.classList.add('flex');
      if(produkIcon) produkIcon.style.transform = 'rotate(180deg)';
    } else {
      produkMenu?.classList.add('hidden');
      produkMenu?.classList.remove('flex');
      if(produkIcon) produkIcon.style.transform = 'rotate(0deg)';
    }
  });

  // Close menu on link click
  mobileLinks.forEach(link => {
    link.addEventListener('click', () => {
      if (isMenuOpen) toggleMenu();
    });
  });
</script>
