---
import { Image } from 'astro:assets';
import heroBg from '../assets/hero/hero-bg.png';
---

<footer class="w-full bg-mitra-blue text-white relative border-t-2 border-mitra-red before:absolute before:top-0 before:left-0 before:w-full before:h-[1px] before:shadow-[0_0_20px_rgba(225,29,72,0.8)]">
  <!-- Pre-Footer: CTA Hubungi Kami Section -->
  <div class="relative w-full py-16 overflow-hidden flex items-center bg-mitra-blue border-b border-white/5">
    <!-- Overlay Pattern / Gradient Glow -->
    <div class="absolute inset-0 z-0 bg-[radial-gradient(ellipse_at_center,rgba(225,29,72,0.15)_0%,rgba(15,23,42,1)_70%)]"></div>
    
    <div class="container mx-auto px-4 relative z-10 text-center animate-fade-in-up">
      <h2 class="text-3xl md:text-5xl font-bold mb-6 text-white drop-shadow-md tracking-tight">Butuh Konsultasi Produk?</h2>
      <p class="text-lg md:text-xl text-slate-300 mb-10 max-w-2xl mx-auto font-light">Tim ahli kami siap membantu Anda menemukan perlengkapan elektronik dan teknik terbaik yang paling sesuai dengan kebutuhan Anda.</p>
      <a href="https://wa.me/6285955360482" class="inline-flex items-center gap-3 bg-mitra-red text-white px-8 py-4 rounded-full font-bold text-lg hover:bg-white hover:text-mitra-red hover:shadow-[0_0_30px_rgba(225,29,72,0.6)] transition-all duration-500 hover:-translate-y-1 group">
        <span>Hubungi via WhatsApp</span>
        <svg class="w-6 h-6 fill-current transition-transform duration-300 group-hover:scale-110" viewBox="0 0 24 24">
          <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.347-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.876 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
        </svg>
      </a>
    </div>
  </div>

  <!-- Main Footer -->
  <div class="container mx-auto px-4 py-16">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12 lg:gap-8">
      
      <!-- Brand & About -->
      <div class="space-y-6">
        <div class="text-3xl font-black text-white tracking-tighter">
          MITRA<span class="text-mitra-red">TECHNIC</span>
        </div>
        <p class="text-slate-400 leading-relaxed font-light">
          Pusat penjualan perlengkapan elektronik yang menyediakan berbagai produk berkualitas dengan harga yang terjangkau. Mulai dari peralatan rumah tangga, komponen listrik, hingga peralatan teknik dan suku cadang.
        </p>
      </div>

      <!-- Quick Links -->
      <div>
        <h3 class="text-xl font-bold mb-6 text-white flex items-center gap-2">
          <span class="w-8 h-1 bg-mitra-red rounded-full"></span> Kategori Produk
        </h3>
        <ul class="space-y-3">
          <li><a href="/alat-listrik" class="text-slate-400 hover:text-mitra-red hover:pl-2 transition-all duration-300 flex items-center gap-2"><span>→</span> Alat Listrik</a></li>
          <li><a href="/lampu" class="text-slate-400 hover:text-mitra-red hover:pl-2 transition-all duration-300 flex items-center gap-2"><span>→</span> Lampu</a></li>
          <li><a href="/kabel" class="text-slate-400 hover:text-mitra-red hover:pl-2 transition-all duration-300 flex items-center gap-2"><span>→</span> Kabel</a></li>
          <li><a href="/sparepart-mesin" class="text-slate-400 hover:text-mitra-red hover:pl-2 transition-all duration-300 flex items-center gap-2"><span>→</span> Suku Cadang Mesin Cuci</a></li>
          <li><a href="/sparepart-kulkas" class="text-slate-400 hover:text-mitra-red hover:pl-2 transition-all duration-300 flex items-center gap-2"><span>→</span> Suku Cadang Kulkas</a></li>
          <li><a href="/sparepart-ac" class="text-slate-400 hover:text-mitra-red hover:pl-2 transition-all duration-300 flex items-center gap-2"><span>→</span> Suku Cadang AC</a></li>
        </ul>
      </div>

      <!-- Contact Info -->
      <div>
        <h3 class="text-xl font-bold mb-6 text-white flex items-center gap-2">
          <span class="w-8 h-1 bg-mitra-red rounded-full"></span> Informasi Kontak
        </h3>
        <ul class="space-y-4">
          <li class="flex items-start gap-4 group">
            <div class="mt-1 p-2 bg-slate-800 rounded-lg group-hover:bg-mitra-red transition-colors duration-300">
              <svg class="w-5 h-5 text-slate-300 group-hover:text-white transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
            </div>
            <div>
              <strong class="block text-slate-200">Alamat:</strong>
              <span class="text-slate-400 leading-relaxed font-light">JL Raya Selatan Pasar Kaibun, Balamoa, Kec. Pangkah, Kab. Tegal, Jawa Tengah 52471</span>
            </div>
          </li>
          <li class="flex items-start gap-4 group">
            <div class="mt-1 p-2 bg-slate-800 rounded-lg group-hover:bg-mitra-red transition-colors duration-300">
              <svg class="w-5 h-5 text-slate-300 group-hover:text-white transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
            </div>
            <div>
              <strong class="block text-slate-200">Telepon / WhatsApp:</strong>
              <a href="https://wa.me/6285955360482" class="text-slate-400 hover:text-mitra-red transition-colors font-light">0859-5536-0482</a>
            </div>
          </li>
        </ul>
      </div>
      
    </div>
  </div>

  <!-- Copyright -->
  <div class="bg-slate-900 py-6 border-t border-slate-800">
    <div class="container mx-auto px-4 text-center text-slate-500 text-sm font-light">
      &copy; {new Date().getFullYear()} Mitra Technic Brothers. All rights reserved.
    </div>
  </div>
</footer>
