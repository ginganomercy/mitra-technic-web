---
import { Image } from 'astro:assets';
import heroBg from '../assets/hero/hero-bg.png';
---

<footer class="w-full">
  <!-- Pre-Footer: Hubungi Kami Section -->
  <div class="relative w-full py-16 lg:py-24 overflow-hidden flex items-center border-t-4 border-mitra-yellow">
    <!-- Latar Belakang Foto Toko -->
    <div class="absolute inset-0 z-0">
      <Image 
        src={heroBg} 
        alt="Mitra Technic Store" 
        class="w-full h-full object-cover object-bottom" 
        width={1920}
        height={1080}
      />
    </div>

    <!-- Konten Hubungi Kami -->
    <div class="container mx-auto px-4 relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <!-- Kolom Kiri: Google Maps -->
        <div class="w-full h-[400px] rounded-xl overflow-hidden shadow-2xl border-4 border-white/10">
          <iframe 
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d1156.402421379123!2d109.1678125!3d-6.9532677!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x2e6fb9b5a8e1b6f1%3A0xb1b3f9c6c2e3a8a!2sMitra%20Technic!5e0!3m2!1sen!2sid!4v1709210000000!5m2!1sen!2sid" 
            width="100%" 
            height="100%" 
            style="border:0;" 
            allowfullscreen="" 
            loading="lazy" 
            referrerpolicy="no-referrer-when-downgrade">
          </iframe>
        </div>

        <!-- Kolom Kanan: Informasi Kontak -->
        <div class="text-white">
          <h2 class="text-4xl md:text-5xl font-black mb-8 text-mitra-yellow drop-shadow-md tracking-wide uppercase">HUBUNGI KAMI</h2>
          
          <div class="space-y-6">
            <!-- Email -->
            <div class="flex items-center gap-4 bg-white/10 backdrop-blur-sm p-4 rounded-lg border border-white/20 hover:bg-white/20 transition-colors">
              <div class="w-12 h-12 bg-white text-mitra-blue rounded-full flex items-center justify-center shrink-0">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
              </div>
              <p class="text-lg font-medium">mitratechnicofficial@gmail.com</p>
            </div>

            <!-- WhatsApp / Telp -->
            <div class="flex items-center gap-4 bg-white/10 backdrop-blur-sm p-4 rounded-lg border border-white/20 hover:bg-white/20 transition-colors">
              <div class="w-12 h-12 bg-white text-mitra-blue rounded-full flex items-center justify-center shrink-0">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path></svg>
              </div>
              <p class="text-lg font-medium">085955360482</p>
            </div>

            <!-- Alamat -->
            <div class="mt-8 bg-mitra-yellow text-mitra-blue p-6 rounded-lg shadow-xl transform hover:-translate-y-1 transition-transform">
              <div class="flex gap-4 items-start">
                <svg class="w-8 h-8 shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                <p class="text-xl font-bold leading-snug">JL Raya Selatan Pasar Kaibun, Balamoa, Kec. Pangkah, Kab. Tegal, Jawa Tengah 52471</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Main Footer (Dark) -->
  <div class="bg-gray-900 text-white pt-12 pb-8">
    <div class="container mx-auto px-4">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-12">
        <div>
          <h3 class="text-xl font-bold mb-4 text-mitra-yellow">Mitra Technic</h3>
          <p class="text-gray-400 leading-relaxed">Pusat penjualan perlengkapan elektronik, alat teknik, dan suku cadang rumah tangga dengan kualitas terjamin dan harga kompetitif.</p>
        </div>
        <div>
          <h3 class="text-xl font-bold mb-4 text-mitra-yellow">Kategori Produk</h3>
          <ul class="space-y-2 text-gray-400">
            <li><a href="/alat-listrik" class="hover:text-mitra-yellow transition-colors">Alat Listrik</a></li>
            <li><a href="/lampu" class="hover:text-mitra-yellow transition-colors">Lampu</a></li>
            <li><a href="/kabel" class="hover:text-mitra-yellow transition-colors">Kabel</a></li>
            <li><a href="/#kategori" class="hover:text-mitra-yellow transition-colors">Semua Kategori...</a></li>
          </ul>
        </div>
        <div>
          <h3 class="text-xl font-bold mb-4 text-mitra-yellow">Jam Operasional</h3>
          <ul class="space-y-2 text-gray-400">
            <li>Senin - Sabtu: 08.00 - 17.00</li>
            <li>Minggu: Tutup</li>
          </ul>
        </div>
      </div>
      <div class="mt-12 pt-8 border-t border-gray-800 text-center text-gray-500 text-sm">
        <p>&copy; {new Date().getFullYear()} Mitra Technic Brothers. All rights reserved.</p>
      </div>
    </div>
  </div>
</footer>
