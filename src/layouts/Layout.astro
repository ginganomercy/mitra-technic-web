---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Pusat penjualan perlengkapan elektronik, alat teknik, dan suku cadang rumah tangga." } = Astro.props;
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/jpeg" href="/favicon.jpg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} | Mitra Technic</title>
    <meta name="description" content={description} />
    
    <!-- Open Graph / WhatsApp Preview Meta Tags -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${title} | Mitra Technic`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/favicon.jpg" />
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  </head>
  <body class="font-['Inter',sans-serif] bg-white text-gray-800 antialiased min-h-screen flex flex-col selection:bg-mitra-yellow selection:text-mitra-blue">
    <Header />
    <main class="flex-grow w-full">
      <slot />
    </main>
    <Footer />
    <WhatsAppButton />
  </body>
</html>
