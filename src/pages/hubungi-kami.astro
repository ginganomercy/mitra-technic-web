---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Hubungi Kami" description="Informasi kontak Mitra Technic Brothers.">
  <Fragment slot="head">
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin=""/>
    <script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
    <style>
      .custom-marker {
        background: transparent;
        border: none;
      }
      /* Efek Silver-Blue khusus untuk layer Peta Standar */
      .map-silver-theme {
        filter: grayscale(100%) sepia(20%) hue-rotate(180deg) brightness(95%) contrast(1.1);
      }
    </style>
  </Fragment>
  <!-- Hero Section -->
  <section class="relative py-24 md:py-32 overflow-hidden flex items-center justify-center bg-white">
    <div class="absolute top-0 left-0 w-full h-full bg-[radial-gradient(ellipse_at_top,rgba(225,29,72,0.05)_0%,rgba(255,255,255,1)_70%)] z-0"></div>
    
    <!-- Hero Content -->
    <div class="relative z-10 container mx-auto px-4 text-center">
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-slate-50 border border-slate-200 text-mitra-red font-medium text-sm mb-6 animate-fade-in-up">
        Layanan Pelanggan
      </div>
      <h1 class="text-5xl md:text-6xl font-black text-slate-900 mb-6 tracking-tight animate-fade-in-up [animation-delay:100ms]">
        <span class="text-mitra-blue">Hubungi</span> <span class="text-mitra-red">Kami</span>
      </h1>
      <div class="w-32 h-1.5 bg-mitra-red mx-auto rounded-full shadow-sm animate-fade-in-up [animation-delay:200ms]"></div>
    </div>
  </section>
  
  <section class="py-20 bg-slate-50 border-y border-slate-100">
    <div class="container mx-auto px-4">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 max-w-6xl mx-auto">
        
        <!-- Informasi Kontak -->
        <div class="animate-fade-in-up [animation-delay:300ms]">
          <h2 class="text-3xl font-bold text-slate-900 mb-6">Informasi Kontak</h2>
          <p class="text-slate-500 mb-10 leading-relaxed font-light">
            Punya pertanyaan seputar produk, stok, atau pemesanan? Jangan ragu untuk menghubungi kami melalui kontak di bawah ini. Tim kami akan segera merespons Anda.
          </p>
          
          <div class="space-y-6">
            <div class="flex items-start gap-5 p-6 bg-white rounded-2xl border border-slate-100 shadow-sm hover:shadow-md transition-shadow duration-300 group">
              <div class="w-14 h-14 bg-slate-50 text-mitra-blue rounded-xl flex items-center justify-center shrink-0 group-hover:bg-mitra-red group-hover:text-white transition-colors duration-300">
                <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
              </div>
              <div>
                <h3 class="font-bold text-slate-900 text-lg mb-1">Alamat Toko</h3>
                <p class="text-slate-500 font-light leading-relaxed">JL Raya Selatan Pasar Kaibun, Balamoa, Kec. Pangkah, Kab. Tegal, Jawa Tengah 52471</p>
              </div>
            </div>
            
            <a href="https://wa.me/6285955360482" target="_blank" class="flex items-start gap-5 p-6 bg-white rounded-2xl border border-slate-100 shadow-sm hover:shadow-[0_10px_30px_rgba(225,29,72,0.1)] hover:border-mitra-red/30 transition-all duration-300 group">
              <div class="w-14 h-14 bg-slate-50 text-mitra-blue rounded-xl flex items-center justify-center shrink-0 group-hover:bg-mitra-red group-hover:text-white transition-colors duration-300">
                <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
              </div>
              <div>
                <h3 class="font-bold text-slate-900 text-lg mb-1 group-hover:text-mitra-red transition-colors">Telepon / WhatsApp</h3>
                <p class="text-slate-500 font-light">0859-5536-0482</p>
              </div>
            </a>
            
            <div class="flex items-start gap-5 p-6 bg-white rounded-2xl border border-slate-100 shadow-sm hover:shadow-md transition-shadow duration-300 group">
              <div class="w-14 h-14 bg-slate-50 text-mitra-blue rounded-xl flex items-center justify-center shrink-0 group-hover:bg-mitra-red group-hover:text-white transition-colors duration-300">
                <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
              </div>
              <div>
                <h3 class="font-bold text-slate-900 text-lg mb-1">Email</h3>
                <p class="text-slate-500 font-light">mitratechnicofficial@gmail.com</p>
              </div>
            </div>
          </div>
        </div>
        
        <!-- Peta Maps (Leaflet OSM + CSS Filter) -->
        <div class="bg-white p-2 rounded-3xl shadow-sm border border-slate-100 animate-fade-in-up [animation-delay:400ms] h-full min-h-[400px]">
          <div class="w-full h-full rounded-2xl overflow-hidden relative group">
            <div id="map" class="absolute inset-0 w-full h-full z-10 bg-[#f1f1f1]"></div>
          </div>
        </div>

        <script is:inline>
          document.addEventListener("DOMContentLoaded", () => {
            // 1. Definisikan layer-layer peta
            
            // Layer Default: OpenStreetMap dengan filter silver-blue kustom
            const osmSilver = L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
              maxZoom: 19,
              className: 'map-silver-theme' // Memanggil filter CSS khusus
            });

            // Layer Satelit: Citra asli dunia nyata dari Esri
            const esriSatellite = L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}', {
              maxZoom: 19
            });

            // Layer Topografi: Garis elevasi kontur bumi
            const openTopoMap = L.tileLayer('https://{s}.tile.opentopomap.org/{z}/{x}/{y}.png', {
              maxZoom: 17
            });

            // 2. Inisialisasi Peta
            const map = L.map('map', {
              center: [-6.9535, 109.1866],
              zoom: 15,
              zoomControl: false,
              attributionControl: false, // Menghilangkan watermark Leaflet sepenuhnya dari akar JS
              scrollWheelZoom: false, // disable zoom scroll for better page scrolling
              layers: [osmSilver] // Layer pertama kali dimuat
            });

            // 3. Tambahkan kontrol UI
            L.control.zoom({ position: 'bottomright' }).addTo(map);

            // Menyatukan layer untuk pilihan dropdown
            const baseMaps = {
              "🗺️ Peta Standar": osmSilver,
              "🛰️ Satelit": esriSatellite,
              "🏔️ Topografi": openTopoMap
            };
            
            // Tambahkan menu Map Type ke pojok kanan atas
            L.control.layers(baseMaps, null, { position: 'topright' }).addTo(map);

            // Kustom ikon HTML untuk marker (Solid & Profesional)
            const customIcon = L.divIcon({
              className: 'custom-marker',
              html: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="#e11d48" class="w-10 h-10 drop-shadow-md">
                      <path fill-rule="evenodd" d="M11.54 22.351l.07.04.028.016a.76.76 0 00.723 0l.028-.015.071-.041a16.975 16.975 0 001.144-.742 19.58 19.58 0 002.683-2.282c1.944-1.99 3.963-4.98 3.963-8.827a8.25 8.25 0 00-16.5 0c0 3.846 2.02 6.837 3.963 8.827a19.58 19.58 0 002.682 2.282 16.975 16.975 0 001.145.742zM12 13.5a3 3 0 100-6 3 3 0 000 6z" clip-rule="evenodd" />
                     </svg>`,
              iconSize: [40, 40],
              iconAnchor: [20, 40],
              popupAnchor: [0, -40]
            });

            // Tambahkan Marker dengan popup
            L.marker([-6.9535, 109.1866], {icon: customIcon}).addTo(map)
              .bindPopup('<b style="color: #e11d48; font-size: 14px;">Mitra Technic</b><br><span style="color:#64748b;">JL Raya Selatan Pasar Kaibun<br>Tegal, Jawa Tengah</span>')
              .openPopup();
          });
        </script>

      </div>
    </div>
  </section>
</Layout>
