---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import heroBg from '../assets/hero/hero-bg.png';
---

<Layout title="Tentang Kami" description="Profil Mitra Technic Brothers.">
  <!-- Hero Section -->
  <section class="relative py-24 md:py-32 overflow-hidden flex items-center justify-center bg-white">
    <div class="absolute top-0 left-0 w-full h-full bg-[radial-gradient(ellipse_at_top,rgba(225,29,72,0.05)_0%,rgba(255,255,255,1)_70%)] z-0"></div>
    
    <!-- Hero Content -->
    <div class="relative z-10 container mx-auto px-4 text-center">
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-slate-50 border border-slate-200 text-mitra-red font-medium text-sm mb-6 animate-fade-in-up">
        Profil Perusahaan
      </div>
      <h1 class="text-5xl md:text-6xl font-black text-slate-900 mb-6 tracking-tight animate-fade-in-up [animation-delay:100ms]">
        <span class="text-mitra-blue">Tentang</span> <span class="text-mitra-red">Kami</span>
      </h1>
      <div class="w-32 h-1.5 bg-mitra-red mx-auto rounded-full shadow-sm animate-fade-in-up [animation-delay:200ms]"></div>
    </div>
  </section>
  
  <!-- Konten Profil -->
  <section class="py-20 bg-slate-50 border-y border-slate-100">
    <div class="container mx-auto px-4 max-w-5xl">
      <div class="bg-white p-8 md:p-16 rounded-3xl shadow-sm border border-slate-100 relative overflow-hidden animate-fade-in-up [animation-delay:300ms] hover:shadow-[0_20px_50px_rgba(225,29,72,0.05)] transition-shadow duration-500">
        <!-- Dekorasi Background -->
        <div class="absolute top-0 right-0 w-64 h-64 bg-mitra-red/5 rounded-full -translate-y-1/2 translate-x-1/3 blur-3xl"></div>
        <div class="absolute bottom-0 left-0 w-64 h-64 bg-mitra-blue/5 rounded-full translate-y-1/3 -translate-x-1/3 blur-3xl"></div>

        <div class="relative z-10 text-center md:text-left">
          <p class="text-2xl md:text-3xl font-bold text-slate-800 leading-snug mb-8">
            <span class="text-mitra-red">MITRA TECHNIC</span> adalah pusat penjualan perlengkapan elektronik terpercaya yang menyediakan berbagai produk berkualitas dengan harga yang terjangkau.
          </p>
          <div class="w-16 h-1 bg-mitra-red mb-8 mx-auto md:mx-0 rounded-full"></div>
          <p class="text-lg text-slate-500 leading-relaxed max-w-4xl font-light">
            Kami hadir untuk memenuhi kebutuhan Anda, mulai dari peralatan rumah tangga hingga komponen listrik dan peralatan teknik. Dengan komitmen pada kualitas dan pelayanan, kami memastikan setiap pelanggan mendapatkan pengalaman berbelanja terbaik.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Misi Kami Section -->
  <section class="py-24 bg-white">
    <div class="container mx-auto px-4 max-w-6xl">
      <div class="text-center mb-16 animate-fade-in-up">
        <h2 class="text-4xl font-black text-slate-900 mb-4 tracking-tight">Misi Kami</h2>
        <div class="w-24 h-1 bg-mitra-red mx-auto rounded-full"></div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- Kartu Misi 1 -->
        <div class="bg-white rounded-2xl p-8 border border-slate-100 shadow-sm hover:shadow-[0_15px_40px_rgba(225,29,72,0.08)] hover:-translate-y-2 transition-all duration-500 group animate-fade-in-up [animation-delay:150ms] relative overflow-hidden">
          <div class="absolute top-0 left-0 w-full h-1 bg-mitra-red transform scale-x-0 group-hover:scale-x-100 transition-transform duration-500 origin-left"></div>
          <div class="w-16 h-16 bg-slate-50 rounded-2xl flex items-center justify-center mb-6 group-hover:bg-mitra-red transition-colors duration-500">
            <svg class="w-8 h-8 text-mitra-blue group-hover:text-white transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"></path></svg>
          </div>
          <p class="text-slate-600 font-medium text-lg leading-relaxed">Menyediakan produk elektronik, listrik, dan teknik dengan standar kualitas terjamin.</p>
        </div>

        <!-- Kartu Misi 2 -->
        <div class="bg-white rounded-2xl p-8 border border-slate-100 shadow-sm hover:shadow-[0_15px_40px_rgba(225,29,72,0.08)] hover:-translate-y-2 transition-all duration-500 group animate-fade-in-up [animation-delay:300ms] relative overflow-hidden">
          <div class="absolute top-0 left-0 w-full h-1 bg-mitra-red transform scale-x-0 group-hover:scale-x-100 transition-transform duration-500 origin-left"></div>
          <div class="w-16 h-16 bg-slate-50 rounded-2xl flex items-center justify-center mb-6 group-hover:bg-mitra-red transition-colors duration-500">
            <svg class="w-8 h-8 text-mitra-blue group-hover:text-white transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
          </div>
          <p class="text-slate-600 font-medium text-lg leading-relaxed">Menawarkan harga yang kompetitif bagi semua pelanggan, baik eceran maupun grosir.</p>
        </div>

        <!-- Kartu Misi 3 -->
        <div class="bg-white rounded-2xl p-8 border border-slate-100 shadow-sm hover:shadow-[0_15px_40px_rgba(225,29,72,0.08)] hover:-translate-y-2 transition-all duration-500 group animate-fade-in-up [animation-delay:450ms] relative overflow-hidden">
          <div class="absolute top-0 left-0 w-full h-1 bg-mitra-red transform scale-x-0 group-hover:scale-x-100 transition-transform duration-500 origin-left"></div>
          <div class="w-16 h-16 bg-slate-50 rounded-2xl flex items-center justify-center mb-6 group-hover:bg-mitra-red transition-colors duration-500">
            <svg class="w-8 h-8 text-mitra-blue group-hover:text-white transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
          </div>
          <p class="text-slate-600 font-medium text-lg leading-relaxed">Memberikan pelayanan yang profesional, responsif, dan solutif terhadap setiap kebutuhan pelanggan.</p>
        </div>
      </div>
    </div>
  </section>
</Layout>
