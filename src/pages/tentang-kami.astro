---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import heroBg from '../assets/hero/hero-bg.png';
---

<Layout title="Tentang Kami" description="Profil Mitra Technic Brothers.">
  <!-- Hero Section -->
  <section class="relative py-24 md:py-32 overflow-hidden flex items-center justify-center">
    <!-- Background Image -->
    <div class="absolute inset-0 z-0">
      <Image 
        src={heroBg} 
        alt="Mitra Technic Store Background" 
        class="w-full h-full object-cover" 
        width={1920}
        height={1080}
      />
    </div>
    <!-- Overlay Transparan -->
    <div class="absolute inset-0 z-0 bg-mitra-blue/90 backdrop-blur-[2px]"></div>

    <!-- Hero Content -->
    <div class="relative z-10 container mx-auto px-4 text-center">
      <h1 class="text-5xl md:text-6xl font-black text-white mb-6 tracking-tight drop-shadow-md">
        Tentang <span class="text-mitra-yellow">Kami</span>
      </h1>
      <div class="w-32 h-1.5 bg-mitra-yellow mx-auto rounded-full shadow-lg"></div>
    </div>
  </section>
  
  <!-- Konten Profil -->
  <section class="py-20 bg-gray-50">
    <div class="container mx-auto px-4 max-w-5xl">
      <div class="bg-white p-8 md:p-16 rounded-3xl shadow-xl border border-gray-100 relative overflow-hidden">
        <!-- Dekorasi Background -->
        <div class="absolute top-0 right-0 w-64 h-64 bg-mitra-blue/5 rounded-full -translate-y-1/2 translate-x-1/3 blur-3xl"></div>
        <div class="absolute bottom-0 left-0 w-64 h-64 bg-mitra-yellow/10 rounded-full translate-y-1/3 -translate-x-1/3 blur-3xl"></div>

        <div class="relative z-10 text-center md:text-left">
          <p class="text-2xl md:text-3xl font-bold text-gray-900 leading-snug mb-8">
            <span class="text-mitra-blue">MITRA TECHNIC</span> adalah pusat penjualan perlengkapan elektronik terpercaya yang menyediakan berbagai produk berkualitas dengan harga yang terjangkau.
          </p>
          <div class="w-16 h-1 bg-mitra-yellow mb-8 mx-auto md:mx-0"></div>
          <p class="text-lg text-gray-600 leading-relaxed max-w-4xl">
            Kami hadir untuk memenuhi kebutuhan Anda, mulai dari peralatan rumah tangga hingga komponen listrik dan peralatan teknik. Dengan komitmen pada kualitas dan pelayanan, kami memastikan setiap pelanggan mendapatkan pengalaman berbelanja terbaik.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Misi Kami Section -->
  <section class="py-20 bg-white">
    <div class="container mx-auto px-4 max-w-6xl">
      <div class="text-center mb-16">
        <h2 class="text-4xl font-black text-mitra-blue mb-4">Misi Kami</h2>
        <div class="w-24 h-1 bg-mitra-yellow mx-auto rounded-full"></div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- Kartu Misi 1 -->
        <div class="bg-gray-50 rounded-2xl p-8 border border-gray-100 hover:shadow-2xl hover:-translate-y-2 transition-all duration-300 group">
          <div class="w-16 h-16 bg-mitra-blue rounded-2xl flex items-center justify-center mb-6 shadow-lg group-hover:scale-110 transition-transform duration-300">
            <svg class="w-8 h-8 text-mitra-yellow" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"></path></svg>
          </div>
          <p class="text-gray-700 font-medium text-lg leading-relaxed">Menyediakan produk elektronik, listrik, dan teknik dengan standar kualitas terjamin.</p>
        </div>

        <!-- Kartu Misi 2 -->
        <div class="bg-gray-50 rounded-2xl p-8 border border-gray-100 hover:shadow-2xl hover:-translate-y-2 transition-all duration-300 group">
          <div class="w-16 h-16 bg-mitra-blue rounded-2xl flex items-center justify-center mb-6 shadow-lg group-hover:scale-110 transition-transform duration-300">
            <svg class="w-8 h-8 text-mitra-yellow" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
          </div>
          <p class="text-gray-700 font-medium text-lg leading-relaxed">Menawarkan harga yang kompetitif bagi semua pelanggan, baik eceran maupun grosir.</p>
        </div>

        <!-- Kartu Misi 3 -->
        <div class="bg-gray-50 rounded-2xl p-8 border border-gray-100 hover:shadow-2xl hover:-translate-y-2 transition-all duration-300 group">
          <div class="w-16 h-16 bg-mitra-blue rounded-2xl flex items-center justify-center mb-6 shadow-lg group-hover:scale-110 transition-transform duration-300">
            <svg class="w-8 h-8 text-mitra-yellow" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
          </div>
          <p class="text-gray-700 font-medium text-lg leading-relaxed">Memberikan pelayanan yang profesional, responsif, dan solutif terhadap setiap kebutuhan pelanggan.</p>
        </div>
      </div>
    </div>
  </section>
</Layout>
